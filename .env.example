# ══════════════════════════════════════════════════════════════════════════════
# CIVAC PRO — Variables de entorno requeridas
# Copia este archivo como .env y completa los valores
# En Vercel: configúralas en Settings → Environment Variables
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
# En Replit: se configura automáticamente
# En producción: URL de conexión PostgreSQL 15+
DATABASE_URL=postgresql://user:password@host:5432/civac_db

# ── Sesión / JWT ──────────────────────────────────────────────────────────────
# Secreto para firmar sesiones y tokens. Usa una cadena larga y aleatoria.
SESSION_SECRET=cambia-esto-por-un-secreto-muy-largo-y-aleatorio

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Configura estas variables solo en el entorno seguro del servidor.
# URI de retorno autorizada: https://<dominio>/api/auth/google/callback
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
CIVAC_PUBLIC_URL=https://tu-dominio-publicado
# Client ID público independiente para el módulo de Google Drive.
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# ── Google AI Studio (Gemini) ─────────────────────────────────────────────────
# Obtén una clave en https://aistudio.google.com/app/apikey.
# La clave solo se usa en Flask y nunca debe tener prefijo VITE_.
GEMINI_API_KEY=tu-gemini-api-key

# ── Pasarela de pagos Wompi (Colombia) ───────────────────────────────────────
# Panel: https://dashboard.wompi.co → Desarrolladores → API Keys
VITE_WOMPI_PUBLIC_KEY=pub_test_...

# ── API Backend ───────────────────────────────────────────────────────────────
# La PWA usa rutas same-origin /api/*; no configures una URL fija en el cliente.
