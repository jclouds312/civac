# ══════════════════════════════════════════════════════════════════════════════
# CIVAC PRO — Variables de entorno requeridas
# Copia este archivo como .env y completa los valores
# En Vercel: configúralas en Settings → Environment Variables
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
# En Replit: se configura automáticamente
# En producción: URL de conexión PostgreSQL 15+
DATABASE_URL=postgresql://user:password@host:5432/civac_db

# ── Sesión / JWT ──────────────────────────────────────────────────────────────
# Secreto para firmar sesiones y tokens. Usa una cadena larga y aleatoria.
SESSION_SECRET=cambia-esto-por-un-secreto-muy-largo-y-aleatorio

# ── Google OAuth + Drive ──────────────────────────────────────────────────────
# Consola: https://console.cloud.google.com/ → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=AIza...

# ── CIVAC IA: claves solo del servidor (nunca usar prefijo VITE_) ─────────────
# Gemini tiene un nivel gratuito sujeto a los límites y condiciones de Google.
# Cloudflare Workers AI incluye una asignación gratuita diaria; excedentes/planes
# y modelos dependen del proveedor. Groq, OpenAI y Anthropic son opciones de uso
# medido y pueden generar cargos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Pasarela de pagos Wompi (Colombia) ───────────────────────────────────────
# Panel: https://dashboard.wompi.co → Desarrolladores → API Keys
VITE_WOMPI_PUBLIC_KEY=pub_test_...

# ── API Backend (solo para despliegue en Vercel) ──────────────────────────────
# URL del API server desplegado por separado (Railway, Render, etc.)
# En desarrollo (Replit): no se necesita (el proxy de Vite lo maneja)
# En Vercel: apunta al servidor Express desplegado
VITE_API_BASE_URL=https://tu-api.railway.app
