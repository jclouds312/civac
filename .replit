modules = ["nodejs-20", "python-3.11", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["bash", "-c", "NODE_ENV=production pnpm --filter @workspace/ganader-ia run build"]
run = ["gunicorn", "--bind", "0.0.0.0:5000", "main:app"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GanaderIA Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Analytics Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GPS Server"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[[workflows.workflow]]
name = "GanaderIA Frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 BASE_PATH=/ pnpm --filter @workspace/ganader-ia run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Analytics Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8099 /home/runner/workspace/.pythonlibs/bin/python3 artifacts/analytics-server/app.py"
waitForPort = 8099

[[workflows.workflow]]
name = "GPS Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/gps-server && /home/runner/workspace/.pythonlibs/bin/python3 manage.py migrate --run-syncdb --no-input 2>/dev/null; /home/runner/workspace/.pythonlibs/bin/python3 manage.py runserver 0.0.0.0:8000 --noreload"
waitForPort = 8000

[agent]
stack = "FLASK_VANILLA_JS"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8083
externalPort = 3001

[[ports]]
localPort = 8090
externalPort = 3003

[[ports]]
localPort = 8099
externalPort = 8099

[[ports]]
localPort = 19538
externalPort = 3000

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "openssl", "postgresql"]

[objectStorage]
defaultBucketID = "replit-objstore-31a0990b-4900-4cdb-9c3f-b8a7326677af"
