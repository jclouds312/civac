{
  "version": 2,
  "buildCommand": "pnpm run build:vercel",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "rewrites": [
    { "source": "/api/analytics/:path*", "destination": "/api/index.py" },
    { "source": "/api/auth/:path*", "destination": "/api/index.py" },
    { "source": "/api/animals/:path*", "destination": "/api/index.py" },
    { "source": "/api/potreros/:path*", "destination": "/api/index.py" },
    { "source": "/api/insumos/:path*", "destination": "/api/index.py" },
    { "source": "/api/personal/:path*", "destination": "/api/index.py" },
    { "source": "/api/reproduccion/:path*", "destination": "/api/index.py" },
    { "source": "/api/alertas/:path*", "destination": "/api/index.py" },
    { "source": "/api/pesajes/:path*", "destination": "/api/index.py" },
    { "source": "/api/lotes/:path*", "destination": "/api/index.py" },
    { "source": "/api/finca/:path*", "destination": "/api/index.py" },
    { "source": "/api/plans/:path*", "destination": "/api/index.py" },
    { "source": "/api/usuarios/:path*", "destination": "/api/index.py" },
    { "source": "/api/licenses/:path*", "destination": "/api/index.py" },
    { "source": "/api/codigos/:path*", "destination": "/api/index.py" },
    { "source": "/api/audit/:path*", "destination": "/api/index.py" },
    { "source": "/api/admin/stats", "destination": "/api/index.py" },
    { "source": "/api/db-status", "destination": "/api/index.py" },
    { "source": "/api/healthz", "destination": "/api/index.py" },
    { "source": "/api/telemetry", "destination": "/api/index.py" },
    { "source": "/api/devices/:path*", "destination": "/api/index.py" },
    { "source": "/api/tramas/test", "destination": "/api/index.py" },
    { "source": "/api/tramas/custom-test", "destination": "/api/index.py" },
    { "source": "/api/tramas/:path*", "destination": "/api/index.py" },
    { "source": "/api/config/:path*", "destination": "/api/index.py" },
    { "source": "/api/status", "destination": "/api/index.py" },
    { "source": "/api/health", "destination": "/api/index.py" },
    { "source": "/api/:path*", "destination": "/api/node.ts" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.js|.*\\.css|.*\\.woff2?|.*\\.png|.*\\.jpg|.*\\.svg|.*\\.ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
