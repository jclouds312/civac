{
  "buildCommand": "pnpm --filter @workspace/ganader-ia run build",
  "outputDirectory": "artifacts/ganader-ia/dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": null,
  "rewrites": [
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
